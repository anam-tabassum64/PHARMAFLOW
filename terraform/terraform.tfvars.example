# ==============================================================================
# PharmaFlow Terraform Production Variables Example
# Copy to terraform.tfvars and customize before running terraform plan
# ==============================================================================

aws_region          = "ap-south-1"
environment         = "production"
instance_type       = "t3.micro"
key_name            = "pharmaflow-ec2-key"
security_group_name = "pharmaflow-sg"
deployment_dir      = "/opt/pharmaflow"

# Replace with your current public IPv4 address (e.g., from https://checkip.amazonaws.com)
# Example: "203.0.113.45/32"
allowed_ssh_cidr    = "0.0.0.0/0"
