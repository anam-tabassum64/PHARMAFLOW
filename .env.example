# =================================================================
# PHARMAFLOW – Environment Configuration Template (.env.example)
# Organization: ALGIONS AI LABS PRIVATE LIMITED
# =================================================================

# Core Application Settings
PROJECT_NAME="PharmaFlow – Pharmacy Inventory Management Platform"
VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
POSTGRES_USER=pharma_admin
POSTGRES_PASSWORD=replace_with_strong_production_password_min_16_chars
POSTGRES_DB=pharmaflow
DATABASE_URL=postgresql+psycopg2://pharma_admin:replace_with_strong_production_password_min_16_chars@db:5432/pharmaflow

# Internal Backend Service Port
PORT=8000

# Frontend API URL (Empty string defaults to relative path /api for reverse proxy)
VITE_API_BASE_URL=
